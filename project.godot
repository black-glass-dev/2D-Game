; Engine configuration file.
; Operation Redline is an original offline Android FPS vertical slice.
config_version=5

[application]
config/name="Operation Redline"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/app_icon.svg"

[autoload]
SettingsService="*res://scripts/services/settings_service.gd"
SaveService="*res://scripts/services/save_service.gd"
MapRegistry="*res://scripts/services/map_registry.gd"
InputService="*res://scripts/services/input_service.gd"
AudioService="*res://scripts/services/audio_service.gd"
LocalizationService="*res://scripts/services/localization_service.gd"
SceneLoader="*res://scripts/services/scene_loader.gd"
GameManager="*res://scripts/services/game_manager.gd"

[display/window]
# Landscape-native design resolution. Canvas-items stretch fills every supported
# device aspect ratio; dynamic 3D scaling is applied by PerformanceGovernor.
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
stretch/aspect="expand"
handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
anti_aliasing/quality/msaa_3d=0
# FXAA-style screen-space smoothing preserves the low-resolution pixel look while
# reducing harsh shimmering on 3D silhouettes at a modest mobile cost.
anti_aliasing/quality/screen_space_aa=1

[physics]
common/enable_pause_aware_picking=true

[gui]
theme/default_font_multichannel_signed_distance_field=false
